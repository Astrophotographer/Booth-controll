[Unit]
Description=Bazaar booth control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bazaar-desk
Environment=PORT=8787
ExecStart=/bin/node /opt/bazaar-desk/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
